{
  "name": "griha",
  "version": "1.0.0",
  "private": true,
  "description": "Griha — household staff management. Owner app + staff tablet, with a live-syncing backend.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "setup": "npm run db:setup --workspace server",
    "db:setup": "npm run db:setup --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
