{
  "name": "griha-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/setup-env.mjs && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node scripts/setup-env.mjs && node dist/index.js",
    "db:setup": "node scripts/setup-env.mjs && prisma migrate deploy",
    "db:migrate": "node scripts/setup-env.mjs && prisma migrate dev",
    "db:reset": "node scripts/setup-env.mjs && prisma migrate reset --force",
    "postinstall": "node scripts/setup-env.mjs && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-async-errors": "^3.1.1",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^6.0.1",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.6.2",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
