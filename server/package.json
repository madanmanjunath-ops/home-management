{
  "name": "griha-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/setup-env.mjs && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node scripts/setup-env.mjs && node dist/index.js",
    "db:setup": "node scripts/setup-env.mjs && prisma migrate deploy",
    "db:migrate": "node scripts/setup-env.mjs && prisma migrate dev",
    "db:reset": "node scripts/setup-env.mjs && prisma migrate reset --force",
    "postinstall": "node scripts/setup-env.mjs && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.7",
    "serverless-http": "^3.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
